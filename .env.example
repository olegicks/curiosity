# Copy to apps/api/.env for local runs outside Docker. Never commit real values.
APP_ENV=local
GIT_SHA=dev
DATABASE_URL=postgresql+psycopg://curiosity:curiosity@localhost:5432/curiosity
# Used only by pytest; DB-backed tests are skipped when unset.
TEST_DATABASE_URL=postgresql+psycopg://curiosity:curiosity@localhost:5432/curiosity_test
DB_POOL_SIZE=10
LOG_LEVEL=INFO
MIN_APP_VERSION=1.0.0
# EXPOSE_OPENAPI=true
