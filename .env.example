# Copy to apps/api/.env for local runs outside Docker. Never commit real values.
APP_ENV=local
GIT_SHA=dev
DATABASE_URL=postgresql+psycopg://curiosity:curiosity@localhost:5432/curiosity
# Used only by pytest; DB-backed tests are skipped when unset.
TEST_DATABASE_URL=postgresql+psycopg://curiosity:curiosity@localhost:5432/curiosity_test
DB_POOL_SIZE=10
LOG_LEVEL=INFO
# At least 32 bytes. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-local-dev-secret-at-least-32-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
RATE_LIMIT_ENABLED=true
MIN_APP_VERSION=1.0.0
# EXPOSE_OPENAPI=true
# AI alternative explanations (docs/spec/08). "fake" needs no key; use "anthropic" in staging/prod.
AI_EXPLANATIONS_ENABLED=true
AI_PROVIDER=fake
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_REFUSAL_FALLBACK=true
AI_TIMEOUT_SECONDS=15
AI_MAX_VARIANTS=3
AI_USER_DAILY_LIMIT=20
AI_USER_BURST_LIMIT=5
AI_DAILY_BUDGET_MICROS=5000000
